# ─────────────────────────────────────────────────────────────────────────────
# ContentAgent — Server Environment Variables
# Copy this file to server/.env for local dev (loaded via `tsx --env-file`).
# For deployment, set these as Environment Variables in your Render service
# settings instead of relying on a committed .env file.
# Schema + required/optional status is enforced in server/src/config.ts.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
# Render sets PORT automatically — do not hardcode this in production.
PORT=3001

# ── Database ─────────────────────────────────────────────────────────────────
# Required. Neon serverless PostgreSQL connection string.
# Get a free DB at https://console.neon.tech -> your project -> Connection Details.
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# ── Auth (Clerk) ──────────────────────────────────────────────────────────────
# Required. Server-side secret key from https://dashboard.clerk.com -> API Keys.
CLERK_SECRET_KEY=

# ── AI APIs ───────────────────────────────────────────────────────────────────
# Required. Primary LLM. Get a key at https://aistudio.google.com/apikey (free tier generous).
GEMINI_API_KEY=

# Optional. Fallback LLM used when Gemini fails 3 consecutive times.
# Get a key at https://console.groq.com/keys (free tier).
GROQ_API_KEY=

# Optional but recommended. Powers the Researcher agent and Hashtag Research.
# Without it, research is skipped and content quality drops. Get a key at https://tavily.com.
TAVILY_API_KEY=

# Optional. Used for DALL-E 3 / gpt-image-1 image generation.
# Falls back to Together AI, then Pollinations (no key) without it.
# Get a key at https://platform.openai.com/api-keys.
OPENAI_API_KEY=

# Optional. Fallback image generation (FLUX.1-schnell-Free model).
# Free tier at https://api.together.ai.
TOGETHER_API_KEY=

# ── Redis / Queue ─────────────────────────────────────────────────────────────
# Upstash Redis for BullMQ job queue + rate limiting.
# Get a free instance at https://console.upstash.com (REST API tab).
# Without these, jobs run directly in the Express process (fine for local dev only).
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# Generic Redis connection URL, used instead of Upstash on platforms that provide
# their own Redis (e.g. Docker Compose local dev). Only one of UPSTASH_REDIS_URL
# or REDIS_URL is needed — production should use UPSTASH_REDIS_URL.
REDIS_URL=

# ── Security Secrets ──────────────────────────────────────────────────────────
# Required in production (app refuses to boot with the insecure dev default).
# Signs OAuth state parameters to prevent CSRF attacks during the OAuth flow.
# Must be at least 32 characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_STATE_SECRET=

# Required if social OAuth posting is enabled. Must be exactly 64 hex characters (32 bytes).
# AES-256-GCM key for encrypting social OAuth tokens stored in the database.
# If this changes, all stored tokens become unreadable — users must re-connect.
# Generate the same way as OAUTH_STATE_SECRET above.
TOKEN_ENCRYPTION_KEY=

# ── App URLs ──────────────────────────────────────────────────────────────────
# Public URL of the deployed frontend, used for OAuth redirect construction.
# Local dev: http://localhost:5173
# Production: your Vercel deployment URL, e.g. https://contentagent.vercel.app
FRONTEND_URL=http://localhost:5173

# Public URL of this backend service itself.
# Local dev: http://localhost:3001
# Production: your Render service URL, e.g. https://contentagent-api.onrender.com
APP_URL=http://localhost:3001

# Comma-separated list of additional allowed CORS origins beyond localhost defaults.
# Production example: CORS_ORIGINS=https://contentagent.vercel.app
CORS_ORIGINS=

# ── Social OAuth (LinkedIn + Twitter) ────────────────────────────────────────
# Optional — only needed for the "Post to social" feature.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Max concurrent content-generation jobs per user per rate-limit window.
RATE_LIMIT_MAX_JOBS=10

# ── Observability (optional) ──────────────────────────────────────────────────
# Server error tracking. App works without this — errors go to console only.
# Get a DSN at https://sentry.io (free tier).
SENTRY_DSN=

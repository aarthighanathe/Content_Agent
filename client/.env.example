# ─────────────────────────────────────────────────────────────────────────────
# ContentAgent — Client Environment Variables
# Copy this file to client/.env.local for local dev, or set these as
# Environment Variables in your Vercel project settings for deployment.
# All VITE_ vars are inlined into the JS bundle at build time — never put
# server-only secrets here, only values safe for a browser to see.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL.
# Local dev: http://localhost:3001
# Production: your deployed Render service URL, e.g. https://contentagent-api.onrender.com
VITE_API_BASE_URL=http://localhost:3001

# Public site origin for canonical + Open Graph / Twitter image URLs in index.html.
# No trailing slash. Production: your custom domain or Vercel URL.
# Local/dev: optional — vite.config.ts falls back to the production Vercel URL
# so %VITE_APP_URL% is never left unsubstituted in built HTML.
VITE_APP_URL=https://content-agent-six-chi.vercel.app

# Clerk publishable key (safe for browser exposure).
# Get from https://dashboard.clerk.com -> API Keys.
VITE_CLERK_PUBLISHABLE_KEY=
# If you use a custom Clerk Frontend API domain (e.g. https://clerk.yourdomain.com),
# add that exact origin to script-src + frame-src in client/vercel.json CSP.

# Optional: PostHog client-side analytics. Leave blank to disable.
# Get from https://posthog.com project settings.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com
